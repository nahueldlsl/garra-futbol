{
  "name": "garra-futbol-web",
  "version": "1.0.0",
  "private": true,
  "description": "Port Web 1:1 de Garra Fútbol (TypeScript strict + HTML5 Canvas 2D + Web Audio API)",
  "license": "MIT",
  "author": "nahueldlsl",
  "repository": {
    "type": "git",
    "url": "https://github.com/nahueldlsl/garra-futbol.git"
  },
  "keywords": [
    "garra-futbol",
    "soccer",
    "canvas",
    "typescript",
    "web-audio",
    "retro-game"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" index.html vite.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" index.html vite.config.ts",
    "test": "npx tsx src/domain/__tests__/verifySimulation.ts && npx tsx --test \"src/**/__tests__/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.10"
  }
}
